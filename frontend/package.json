    "axios": "^1.13.5",
    "firebase": "^12.8.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-leaflet": "^5.0.0",
    "react-loader-spinner": "^8.0.2",
    "react-rating-stars-component": "^2.2.0",
